# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/lessgo?schema=public"

# Server
PORT=5000

# Auth
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# CORS - the URL your frontend runs on
CLIENT_URL="http://localhost:3000"

# Google Gemini - powers the AI Mock Interview Bot's dynamic follow-ups and the
# Resume Analyzer / STAR builder. Gemini has a free tier - get a key at
# https://aistudio.google.com/app/apikey
# The app runs fine without it — those specific features will just return a
# clear "AI service not configured" error until this is set.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
